# Copy to .env and edit
POSTGRES_PASSWORD=change-me

# Only for runs outside Docker (for example `auth` on the host):
DATABASE_URL=postgresql://mail_informer:change-me@127.0.0.1:5432/mail_informer
CLIENT_SECRET_PATH=secrets/client_secret.json
TOKEN_PATH=secrets/token.json
# The poller reads its accounts from this file (copy accounts.toml.example). Compose sets /secrets/accounts.toml.
ACCOUNTS_PATH=secrets/accounts.toml

# Analyzer: any server with the OpenAI chat completions API. Default: Ollama on the host (see README).
# ANALYZER_MODEL is required. Choice from `evaluate`: qwen3.5:4b with prompt v2.
ANALYZER_MODEL=qwen3.5:4b
# MODEL_URL=http://host.docker.internal:11434/v1
# Optional key for the model server. It is a SECRET: keep it in .env, never commit or log it.
# MODEL_API_KEY=
# Ollama: models that think (qwen3.5) are slow and may time out unless thinking is off. Servers that
# do not know this field may answer an error, so leave it empty for them.
MODEL_REASONING_EFFORT=none
# A cloud model sends the sender, subject and start of every mail to that service.
# It is used only if you set both of these (the address must be https://):
# MODEL_URL=https://api.openai.com/v1
# ALLOW_REMOTE_MODEL=true

# Notifier: Home Assistant webhook address. The id in it is a SECRET: keep it in .env, never commit or log it.
# The host name must resolve inside the Compose network: use a full name or the IP, not a short name.
# HA_WEBHOOK_URL=http://homeassistant.fritz.box:8123/api/webhook/<your-secret-id>
